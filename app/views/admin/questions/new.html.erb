<div class="min-h-screen bg-gray-50 py-8">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white rounded-lg shadow-md p-8">
      <h1 class="text-3xl font-bold text-gray-900 mb-6">Add Question to <%= @quiz.title %></h1>
      
      <%= form_with model: [:admin, @quiz, @question], data: { controller: "question-form" } do |form| %>
        <% if @question.errors.any? %>
          <div class="bg-red-50 border border-red-400 text-red-700 px-4 py-3 rounded mb-6">
            <h3 class="font-bold">Please correct the following errors:</h3>
            <ul class="list-disc list-inside">
              <% @question.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="space-y-6">
          <!-- Question Type -->
          <div>
            <%= form.label :question_type, "Question Type", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.select :question_type, 
                options_for_select([
                  ["Multiple Choice", "multiple_choice"],
                  ["True/False", "true_false"],
                  ["Matching", "matching"]
                ], @question.question_type),
                {},
                class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500",
                data: { action: "change->question-form#typeChanged" } %>
          </div>

          <!-- Question Content -->
          <div>
            <%= form.label :content, "Question", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.text_area :content, 
                rows: 3,
                class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500",
                placeholder: "Enter your question..." %>
          </div>

          <!-- Points -->
          <div>
            <%= form.label :points, "Points", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.number_field :points, 
                value: @question.points || 10,
                min: 1,
                class: "mt-1 block w-32 px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500" %>
          </div>

          <!-- Options -->
          <div id="options-container">
            <div class="flex justify-between items-center mb-4">
              <label class="block text-sm font-medium text-gray-700">Answer Options</label>
              <button type="button" 
                      data-action="click->question-form#addOption"
                      class="px-3 py-1 text-sm text-indigo-600 border border-indigo-600 rounded hover:bg-indigo-50 transition-colors duration-200">
                + Add Option
              </button>
            </div>
            
            <div data-question-form-target="optionsContainer">
              <%= form.fields_for :options do |option_form| %>
                <div class="border border-gray-200 rounded-lg p-4 mb-3" data-question-form-target="optionField">
                  <div class="flex gap-4 items-start">
                    <div class="flex-1">
                      <%= option_form.text_field :content, 
                          class: "block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500",
                          placeholder: "Enter option text..." %>
                    </div>
                    
                    <div class="flex items-center gap-2" data-question-form-target="correctCheckbox">
                      <%= option_form.check_box :correct, class: "h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded" %>
                      <%= option_form.label :correct, "Correct", class: "text-sm text-gray-700" %>
                    </div>
                    
                    <div class="hidden" data-question-form-target="matchKeyField">
                      <%= option_form.text_field :match_key, 
                          class: "block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500",
                          placeholder: "Match value..." %>
                    </div>
                    
                    <button type="button" 
                            data-action="click->question-form#removeOption"
                            class="text-red-600 hover:text-red-800">
                      <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                      </svg>
                    </button>
                  </div>
                  <%= option_form.hidden_field :_destroy %>
                </div>
              <% end %>
            </div>
          </div>

          <!-- Submit Buttons -->
          <div class="flex justify-end gap-4 pt-6 border-t">
            <%= link_to "Cancel", admin_quiz_path(@quiz), class: "px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors duration-200" %>
            <%= form.submit "Save Question", class: "px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors duration-200" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
