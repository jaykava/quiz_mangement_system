<div class="min-h-screen bg-gradient-to-br from-purple-50 to-blue-50 flex items-center justify-center p-4">
  <div class="max-w-2xl w-full">
    <div class="bg-white rounded-2xl shadow-2xl p-8">
      <div class="text-center mb-8">
        <h1 class="text-4xl font-bold text-gray-900 mb-4"><%= @quiz.title %></h1>
        <p class="text-lg text-gray-600 mb-6"><%= @quiz.description %></p>
        
        <div class="flex justify-center gap-8 mb-8">
          <div class="text-center">
            <div class="text-3xl font-bold text-indigo-600"><%= @quiz.questions.count %></div>
            <div class="text-sm text-gray-500">Questions</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-purple-600"><%= @quiz.total_points %></div>
            <div class="text-sm text-gray-500">Total Points</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-orange-600"><%= @quiz.time_per_question || 10 %>s</div>
            <div class="text-sm text-gray-500">Per Question</div>
          </div>
        </div>
        
        <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6">
          <h3 class="font-semibold text-blue-900 mb-2">Instructions:</h3>
          <ul class="text-sm text-blue-800 text-left space-y-1">
            <li>• Answer all questions to complete the quiz</li>
            <li>• Each question is worth points based on difficulty</li>
            <li>• You cannot go back once you submit an answer</li>
            <li>• Your score will be shown at the end</li>
          </ul>
        </div>
        
        <!-- Timer Warning -->
        <div class="bg-orange-50 border border-orange-200 rounded-lg p-4 mb-6">
          <div class="flex items-center justify-center gap-2 text-orange-800">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="font-semibold">Timed Quiz!</span>
          </div>
          <p class="text-sm text-orange-700 mt-2">
            You have <strong><%= @quiz.time_per_question || 10 %> seconds</strong> to answer each question. 
            The quiz will automatically move to the next question when time runs out.
          </p>
        </div>
        
        <%= button_to "Begin Quiz", question_quiz_attempt_path(@attempt), 
            method: :get,
            class: "w-full bg-gradient-to-r from-indigo-600 to-purple-600 text-white font-bold py-4 px-8 rounded-lg hover:from-indigo-700 hover:to-purple-700 transform hover:scale-105 transition-all duration-200 shadow-lg text-lg" %>
      </div>
    </div>
  </div>
</div>
