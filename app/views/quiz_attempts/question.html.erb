<div class="min-h-screen bg-gradient-to-br from-purple-50 to-blue-50" data-controller="quiz-progress">
  <!-- Progress Bar -->
  <div class="bg-white shadow-md sticky top-0 z-10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <div class="flex justify-between items-center mb-2">
        <span class="text-sm font-medium text-gray-700">Question <%= @current_question_index + 1 %> of <%= @questions.count %></span>
        <span class="text-sm font-medium text-indigo-600"><%= (((@current_question_index + 1).to_f / @questions.count) * 100).round %>% Complete</span>
      </div>
      <div class="w-full bg-gray-200 rounded-full h-3 overflow-hidden">
        <div class="bg-gradient-to-r from-indigo-600 to-purple-600 h-3 rounded-full transition-all duration-500 ease-out"
             style="width: <%= (((@current_question_index + 1).to_f / @questions.count) * 100).round %>%"
             data-quiz-progress-target="bar"></div>
      </div>
    </div>
  </div>

  <!-- Question Content -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="bg-white rounded-2xl shadow-2xl overflow-hidden animate-fade-in">
      <div class="bg-gradient-to-r from-indigo-500 to-purple-600 px-8 py-6">
        <div class="flex items-center justify-between text-white">
          <span class="text-sm font-semibold"><%= @question.question_type.titleize %></span>
          <span class="bg-white/20 px-3 py-1 rounded-full text-sm font-semibold"><%= @question.points %> Points</span>
        </div>
      </div>
      
      <div class="p-8">
        <% if flash[:alert] %>
          <div class="bg-red-50 border-l-4 border-red-400 text-red-700 px-4 py-3 rounded mb-6 animate-fade-in" role="alert">
            <div class="flex items-center">
              <svg class="h-5 w-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
              </svg>
              <span class="font-medium"><%= flash[:alert] %></span>
            </div>
          </div>
        <% end %>
        
        <h2 class="text-2xl font-bold text-gray-900 mb-8"><%= @question.content %></h2>
        
        <%= form_with url: answer_quiz_attempt_path(@attempt), method: :post, data: { controller: "quiz-form" } do |form| %>
          <%= form.hidden_field :question_id, value: @question.id %>
          <%= form.hidden_field :current_index, value: @current_question_index %>
          
          <div class="space-y-4">
            <% if @question.question_type == 'multiple_choice' %>
              <!-- Multiple Choice Options -->
              <% @question.options.each do |option| %>
                <label class="flex items-start p-4 border-2 border-gray-200 rounded-xl cursor-pointer hover:border-indigo-400 hover:bg-indigo-50 transition-all duration-200 group">
                  <%= check_box_tag 'option_ids[]', option.id, false, 
                      class: "mt-1 h-5 w-5 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded" %>
                  <span class="ml-3 text-gray-900 group-hover:text-indigo-900 flex-1"><%= option.content %></span>
                </label>
              <% end %>
              
            <% elsif @question.question_type == 'true_false' %>
              <!-- True/False Options -->
              <% @question.options.each do |option| %>
                <label class="flex items-center p-6 border-2 border-gray-200 rounded-xl cursor-pointer hover:border-indigo-400 hover:bg-indigo-50 transition-all duration-200 group">
                  <%= radio_button_tag 'option_id', option.id, false, 
                      class: "h-5 w-5 text-indigo-600 focus:ring-indigo-500 border-gray-300" %>
                  <span class="ml-3 text-lg font-medium text-gray-900 group-hover:text-indigo-900"><%= option.content %></span>
                </label>
              <% end %>
              
            <% elsif @question.question_type == 'matching' %>
              <!-- Matching Options -->
              <div class="grid grid-cols-2 gap-6" data-controller="matching">
                <% shuffled_options = @question.options.shuffle %>
                <% shuffled_match_keys = @question.options.map(&:match_key).shuffle %>
                
                <div>
                  <h3 class="text-sm font-semibold text-gray-700 mb-4">Items</h3>
                  <div class="space-y-3">
                    <% shuffled_options.each do |option| %>
                      <div class="p-4 bg-gray-50 border border-gray-200 rounded-lg font-medium text-gray-900">
                        <%= option.content %>
                      </div>
                    <% end %>
                  </div>
                </div>
                
                <div>
                  <h3 class="text-sm font-semibold text-gray-700 mb-4">Matches (Select for each item)</h3>
                  <div class="space-y-3">
                    <% shuffled_options.each_with_index do |option, index| %>
                      <div>
                        <%= select_tag "matches[#{index}][match_key]", 
                            options_for_select(shuffled_match_keys.map { |mk| [mk, mk] }),
                            class: "block w-full px-3 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-indigo-500 focus:border-indigo-500" %>
                        <%= hidden_field_tag "matches[#{index}][option_id]", option.id %>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
          
          <div class="mt-8 flex justify-end">
            <%= form.submit "Next Question →", 
                class: "px-8 py-4 bg-gradient-to-r from-indigo-600 to-purple-600 text-white font-bold rounded-lg hover:from-indigo-700 hover:to-purple-700 transform hover:scale-105 transition-all duration-200 shadow-lg" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .animate-fade-in {
    animation: fade-in 0.5s ease-out;
  }
</style>
