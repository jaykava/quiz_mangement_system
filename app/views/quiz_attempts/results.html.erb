<div class="min-h-screen bg-gradient-to-br from-purple-50 to-blue-50 py-12">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Score Card -->
    <div class="bg-white rounded-2xl shadow-2xl overflow-hidden mb-8 animate-fade-in">
      <div class="bg-gradient-to-r from-indigo-500 to-purple-600 px-8 py-12 text-center">
        <h1 class="text-4xl font-bold text-white mb-4">Quiz Completed!</h1>
        <div class="text-6xl font-bold text-white mb-2"><%= @attempt.percentage.round %>%</div>
        <p class="text-xl text-white/90">
          You scored <%= @attempt.score.to_i %> out of <%= @attempt.quiz.total_points %> points
        </p>
      </div>
      
      <div class="p-8">
        <div class="grid grid-cols-3 gap-6 mb-6">
          <div class="text-center p-4 bg-green-50 rounded-lg">
            <div class="text-3xl font-bold text-green-600"><%= @attempt.attempt_answers.where(correct: true).count %></div>
            <div class="text-sm text-gray-600 mt-1">Correct</div>
          </div>
          <div class="text-center p-4 bg-red-50 rounded-lg">
            <div class="text-3xl font-bold text-red-600"><%= @attempt.attempt_answers.where(correct: false).count %></div>
            <div class="text-sm text-gray-600 mt-1">Incorrect</div>
          </div>
          <div class="text-center p-4 bg-blue-50 rounded-lg">
            <div class="text-3xl font-bold text-blue-600"><%= @attempt.total_questions %></div>
            <div class="text-sm text-gray-600 mt-1">Total Questions</div>
          </div>
        </div>
        
        <div class="text-center">
          <%= link_to "Back to Quizzes", root_path, 
              class: "inline-block px-8 py-3 bg-gradient-to-r from-indigo-600 to-purple-600 text-white font-semibold rounded-lg hover:from-indigo-700 hover:to-purple-700 transform hover:scale-105 transition-all duration-200 shadow-lg" %>
        </div>
      </div>
    </div>

    <!-- Review Answers -->
    <div class="bg-white rounded-2xl shadow-xl p-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Review Your Answers</h2>
      
      <div class="space-y-6">
        <% @questions.each_with_index do |question, index| %>
          <% user_answer = @attempt.attempt_answers.find_by(question: question) %>
          <% is_correct = user_answer&.correct %>
          
          <div class="border-2 <%= is_correct ? 'border-green-200 bg-green-50' : 'border-red-200 bg-red-50' %> rounded-xl p-6 transition-all duration-300">
            <div class="flex items-start justify-between mb-4">
              <div class="flex-1">
                <div class="flex items-center gap-3 mb-2">
                  <span class="flex items-center justify-center w-8 h-8 <%= is_correct ? 'bg-green-100 text-green-600' : 'bg-red-100 text-red-600' %> rounded-full font-bold">
                    <%= index + 1 %>
                  </span>
                  <% if is_correct %>
                    <span class="px-3 py-1 text-sm font-semibold text-green-800 bg-green-100 rounded-full flex items-center gap-1">
                      <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                      </svg>
                      Correct
                    </span>
                  <% else %>
                    <span class="px-3 py-1 text-sm font-semibold text-red-800 bg-red-100 rounded-full flex items-center gap-1">
                      <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                      </svg>
                      Incorrect
                    </span>
                  <% end %>
                  <span class="text-sm text-gray-600"><%= question.points %> pts</span>
                </div>
                <p class="text-lg font-semibold text-gray-900 ml-11"><%= question.content %></p>
              </div>
            </div>
            
            <div class="ml-11 space-y-3">
              <% if question.question_type == 'matching' %>
                <!-- Matching question review -->
                <div class="bg-white rounded-lg p-4">
                  <h4 class="font-semibold text-gray-700 mb-3">Correct Matches:</h4>
                  <div class="space-y-2">
                    <% question.options.each do |option| %>
                      <div class="flex items-center justify-between p-2 bg-gray-50 rounded">
                        <span class="text-gray-900"><%= option.content %></span>
                        <span class="text-green-600 font-semibold">→ <%= option.match_key %></span>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% else %>
                <!-- Multiple choice / True-False review -->
                <% question.options.each do |option| %>
                  <% user_selected = user_answer&.option_id == option.id %>
                  <div class="flex items-center gap-3 p-3 rounded-lg <%= option.correct ? 'bg-green-100 border-2 border-green-300' : (user_selected ? 'bg-red-100 border-2 border-red-300' : 'bg-white border border-gray-200') %>">
                    <% if option.correct %>
                      <svg class="h-6 w-6 text-green-600 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                      </svg>
                    <% elsif user_selected %>
                      <svg class="h-6 w-6 text-red-600 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                      </svg>
                    <% else %>
                      <div class="h-6 w-6 flex-shrink-0"></div>
                    <% end %>
                    
                    <span class="<%= option.correct ? 'text-green-900 font-semibold' : (user_selected ? 'text-red-900' : 'text-gray-600') %>">
                      <%= option.content %>
                    </span>
                    
                    <% if option.correct %>
                      <span class="ml-auto text-xs text-green-700 font-semibold">✓ Correct Answer</span>
                    <% elsif user_selected %>
                      <span class="ml-auto text-xs text-red-700 font-semibold">✗ Your Answer</span>
                    <% end %>
                  </div>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .animate-fade-in {
    animation: fade-in 0.6s ease-out;
  }
</style>
