<div class="min-h-screen bg-gradient-to-br from-purple-50 to-blue-50 py-12">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white rounded-2xl shadow-2xl overflow-hidden">
      <div class="bg-gradient-to-r from-indigo-500 to-purple-600 px-8 py-12 text-center">
        <h1 class="text-4xl font-bold text-white mb-4"><%= @quiz.title %></h1>
        <p class="text-xl text-white/90 mb-6"><%= @quiz.description %></p>
        
        <div class="flex justify-center gap-8 mb-8">
          <div class="bg-white/20 rounded-lg p-4">
            <div class="text-3xl font-bold text-white"><%= @quiz.questions.count %></div>
            <div class="text-sm text-white/80">Questions</div>
          </div>
          <div class="bg-white/20 rounded-lg p-4">
            <div class="text-3xl font-bold text-white"><%= @quiz.total_points %></div>
            <div class="text-sm text-white/80">Total Points</div>
          </div>
        </div>
      </div>
      
      <div class="p-8">
        <div class="bg-blue-50 border border-blue-200 rounded-lg p-6 mb-8">
          <h3 class="font-bold text-blue-900 mb-3 text-lg">📋 Quiz Instructions</h3>
          <ul class="text-blue-800 space-y-2">
            <li class="flex items-start">
              <span class="mr-2">•</span>
              <span>Answer all questions to complete the quiz</span>
            </li>
            <li class="flex items-start">
              <span class="mr-2">•</span>
              <span>Each question is worth points based on difficulty</span>
            </li>
            <li class="flex items-start">
              <span class="mr-2">•</span>
              <span>You cannot go back once you submit an answer</span>
            </li>
            <li class="flex items-start">
              <span class="mr-2">•</span>
              <span>Your score and correct answers will be shown at the end</span>
            </li>
          </ul>
        </div>
        
        <div class="flex gap-4">
          <%= link_to "← Back to Quizzes", root_path, 
              class: "flex-1 text-center px-6 py-4 border-2 border-gray-300 rounded-lg text-gray-700 font-semibold hover:bg-gray-50 transition-colors duration-200" %>
          <%= button_to "Start Quiz →", start_attempt_quiz_path(@quiz), 
              method: :post,
              class: "flex-1 text-center px-6 py-4 bg-gradient-to-r from-indigo-600 to-purple-600 text-white font-bold rounded-lg hover:from-indigo-700 hover:to-purple-700 transform hover:scale-105 transition-all duration-200 shadow-lg" %>
        </div>
      </div>
    </div>
  </div>
</div>
